# Másold .env néven (a .env NINCS verziókezelve) – vagy állítsd be közvetlenül környezeti változóként.
# A szerver NEM tölti be automatikusan a .env-et; helyben pl.:  set -a; . ./.env; set +a; npm start

# HTTP port. Renderen a platform állítja be (ne írd felül).
PORT=3000

# PostgreSQL kapcsolat. Ha üres / hiányzik -> memóriabeli ranglista (újraindításkor törlődik!).
# Renderen: a Render Postgres "Internal Database URL"-je (a Dashboardon / MCP-n keresztül állítva, SOHA nem commitolva).
# Példa formátum:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# A pontszám-tábla neve a (közös Kománovics-) adatbázisban. Alapértelmezés: komanovics_scores
# (csak kisbetű, szám, aláhúzás; a tábla induláskor automatikusan létrejön). A KOMÁNOVICS Darts a darts_scores-t használja.
SCORES_TABLE=

# SSL kikényszerítése a Postgres kapcsolathoz: "true" | "false" | üres (=automatikus:
# külső *.render.com host esetén SSL, belső hostnál nincs SSL).
DATABASE_SSL=

# Rate limit: max ennyi pontszám-beküldés IP-nként egy percben (alapértelmezés: 5).
SCORE_RATE_LIMIT_PER_MIN=5
